# Dependencies & builds (per-package .gitignore files cover their specifics)
node_modules/
dist/

# Local state — the agent service recreates this; session ids are per-machine
server/sessions.json

# Strategy/roadmap docs — kept out of the repo regardless of visibility (the
# PRD and execution spec; the root CLAUDE.md carries the roadmap). Brand/mascot
# TEST material (eval corpus, workbench scenes/assets/docs/build scripts) IS
# included now — the team needs it to exercise the app.
BRIEF.md
docs/plan.md
docs/impl-*.md
/CLAUDE.md

# Auto-propose scratch — the engine writes the drafted brief here and reads it
# straight back out; the brief that matters travels to the app, and one of these
# lands per propose run.
workbench/assets/*.brief.txt

# OS / editor noise
.DS_Store
*.log
.idea
.vscode/*
!.vscode/extensions.json
